FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends nginx openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements-production.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend /app/backend
COPY deploy /app/deploy
COPY frontend/dist /var/www/noticeboard/current
ENV NOTICEBOARD_ENV=production PYTHONDONTWRITEBYTECODE=1
CMD ["python", "deploy/verify_proxy.py"]
